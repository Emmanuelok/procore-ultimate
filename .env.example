# --- API ---
# Port the API listens on
PORT=4000
HOST=0.0.0.0

# Postgres connection. If unset, the API falls back to an embedded PGlite
# database persisted under .pglite/ (zero-dependency local development).
# DATABASE_URL=postgres://constructos:constructos@localhost:5432/constructos

# Secret used to sign access / refresh JWTs. Generate with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# --- File storage ---
# local = disk under STORAGE_DIR (dev default, or mount a volume)
# s3    = any S3-compatible store: Railway Buckets, AWS S3, R2, MinIO
STORAGE_DRIVER=local
STORAGE_DIR=./data/storage
# Required when STORAGE_DRIVER=s3 (Railway Buckets shown):
# S3_ENDPOINT=https://storage.railway.app
# S3_REGION=auto
# S3_BUCKET=constructos-files
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_FORCE_PATH_STYLE=false

# --- Production serving ---
# Serve the built SPA same-origin from the API (set in the Docker image)
# WEB_DIST_DIR=/app/public
# Honor x-forwarded-* from the platform proxy (Railway/ALB) — set in image
# TRUST_PROXY=true
# Per-IP request ceilings
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_PER_MINUTE=300
AUTH_RATE_LIMIT_MAX_PER_MINUTE=10

# --- AI (optional — AI features degrade gracefully when unset) ---
# ANTHROPIC_API_KEY=sk-ant-...
# Default model for platform AI agents
AI_MODEL=claude-opus-5

# --- Ledger anchoring & escrow ---
# The Ed25519 private key seals are signed with (PKCS8 PEM, or base64 of it).
# Generate: openssl genpkey -algorithm ed25519 -out anchor-key.pem
# UNSET outside production, the key is derived from AUTH_SECRET instead — which
# means the same operator that runs the app holds it, so seals then prove
# integrity against a database-only attacker but NOT against the operator.
# Production refuses to seal without this set.
# ANCHOR_SIGNING_KEY=

# The fingerprints a verifier will accept, pinned OUT OF BAND. Without this,
# signature checking reads public keys from `signing_keys` — a table inside the
# database the seal exists to police — so an attacker with database write access
# can register their own key, re-sign a rewritten chain, and it verifies clean.
# Pinning moves the trust anchor out of the store under attack; seals signed by
# an unpinned key are then reported as forged. Take the value from
# GET /api/v1/ledger/keys and hold it somewhere the database cannot reach.
# ANCHOR_TRUSTED_FINGERPRINTS=

# How often a heartbeat seal is written even when nothing changed. This bounds
# how long a tail truncation can hide. Default 24.
# ANCHOR_HEARTBEAT_HOURS=24

# Timestamp authority / calendar. Unset, seals prove ORDER, not wall-clock time,
# and the anchor providers report themselves unavailable rather than faking a proof.
# ANCHOR_TSA_URL=
# ANCHOR_OTS_CALENDAR_URL=

# --- Integration surface ---
# Master key webhook signing secrets are HKDF-derived from. Falls back to
# AUTH_SECRET, and under that fallback anyone who can read the JWT secret can
# forge a signature a receiver would accept. Rotating this invalidates every
# derived secret (endpoints then report secretFingerprintMatches: false).
# WEBHOOK_SIGNING_KEY=

# --- Web ---
# Base URL the web app uses to reach the API (Vite dev server proxies /api)
VITE_API_URL=http://localhost:4000
