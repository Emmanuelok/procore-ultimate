# --- API ---
# Port the API listens on
PORT=4000
HOST=0.0.0.0

# Postgres connection. If unset, the API falls back to an embedded PGlite
# database persisted under .pglite/ (zero-dependency local development).
# DATABASE_URL=postgres://constructos:constructos@localhost:5432/constructos

# Secret used to sign access / refresh JWTs. Generate with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# --- File storage ---
# local = disk under STORAGE_DIR (dev default, or mount a volume)
# s3    = any S3-compatible store: Railway Buckets, AWS S3, R2, MinIO
STORAGE_DRIVER=local
STORAGE_DIR=./data/storage
# Required when STORAGE_DRIVER=s3 (Railway Buckets shown):
# S3_ENDPOINT=https://storage.railway.app
# S3_REGION=auto
# S3_BUCKET=constructos-files
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_FORCE_PATH_STYLE=false

# --- Production serving ---
# Serve the built SPA same-origin from the API (set in the Docker image)
# WEB_DIST_DIR=/app/public
# Honor x-forwarded-* from the platform proxy (Railway/ALB) — set in image
# TRUST_PROXY=true
# Per-IP request ceilings
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_PER_MINUTE=300
AUTH_RATE_LIMIT_MAX_PER_MINUTE=10

# --- AI (optional — AI features degrade gracefully when unset) ---
# ANTHROPIC_API_KEY=sk-ant-...
# Default model for platform AI agents
AI_MODEL=claude-opus-5

# --- Ledger anchoring & escrow ---
# The Ed25519 private key seals are signed with (PKCS8 PEM, or base64 of it).
# Generate: openssl genpkey -algorithm ed25519 -out anchor-key.pem
# UNSET outside production, the key is derived from AUTH_SECRET instead — which
# means the same operator that runs the app holds it, so seals then prove
# integrity against a database-only attacker but NOT against the operator.
# Production refuses to seal without this set.
# ANCHOR_SIGNING_KEY=

# The fingerprints a verifier will accept, pinned OUT OF BAND. Without this,
# signature checking reads public keys from `signing_keys` — a table inside the
# database the seal exists to police — so an attacker with database write access
# can register their own key, re-sign a rewritten chain, and it verifies clean.
# Pinning moves the trust anchor out of the store under attack; seals signed by
# an unpinned key are then reported as forged. Take the value from
# GET /api/v1/ledger/keys and hold it somewhere the database cannot reach.
# ANCHOR_TRUSTED_FINGERPRINTS=

# How often a heartbeat seal is written even when nothing changed. This bounds
# how long a tail truncation can hide. Default 24.
# ANCHOR_HEARTBEAT_HOURS=24

# Timestamp authority / calendar. Unset, seals prove ORDER, not wall-clock time,
# and the anchor providers report themselves unavailable rather than faking a proof.
# ANCHOR_TSA_URL=
# ANCHOR_OTS_CALENDAR_URL=

# --- Integration surface ---
# Master key webhook signing secrets are HKDF-derived from. Falls back to
# AUTH_SECRET, and under that fallback anyone who can read the JWT secret can
# forge a signature a receiver would accept. Rotating this invalidates every
# derived secret (endpoints then report secretFingerprintMatches: false).
# WEBHOOK_SIGNING_KEY=

# --- Outbound email (Phase 8) ---
# The platform composes verification, reset, invitation, MFA-enrolled and
# new-device messages. UNSET, it dispatches NONE of them: the no-op transport
# records what it would have sent and every affected API response carries
# `dispatched: false` with a reason naming EMAIL_PROVIDER. That is deliberate —
# an invitation nobody receives must not read as a success — but it does mean
# invitations, resets and verification do not reach anyone until this is set.
#
# none     (default) record only, nothing leaves the building
# resend   Resend HTTP API — needs EMAIL_API_KEY + EMAIL_FROM_ADDRESS
# postmark Postmark HTTP API — needs EMAIL_API_KEY + EMAIL_FROM_ADDRESS
# smtp     a DOCUMENTED ADAPTER SLOT, not a sender: no SMTP client ships in
#          this repo, so it records and says so per message. Use resend or
#          postmark, which need no npm dependency.
# Setting EMAIL_PROVIDER without its companions refuses to boot rather than
# failing per message, in the background, on the one that mattered.
EMAIL_PROVIDER=none
# EMAIL_API_KEY=re_...
# Envelope sender. Must be on a domain the provider has verified, or every
# message is rejected at the provider rather than at the recipient.
# EMAIL_FROM_ADDRESS=no-reply@example.com
# Display name on the From header. Default "ConstructOS".
EMAIL_FROM_NAME=ConstructOS
# Where replies go. Unset, replies go to EMAIL_FROM_ADDRESS.
# EMAIL_REPLY_TO=support@example.com
# Override the provider API host (self-hosted gateway, or a test double).
# Unset, the adapter uses the provider's own host.
# EMAIL_API_BASE_URL=
# SMTP adapter slot. Reserved so the deployment surface is stable when an
# adapter is written; setting these today does NOT send anything.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SECURE=false

# Absolute origin of the web app. Every link inside a message is built from
# this — verification, password reset, invitation acceptance. Unset it defaults
# to the Vite dev server, so production mail would carry localhost links that
# nobody outside the machine can open. Set it in every deployed environment.
APP_BASE_URL=http://localhost:5173

# --- Auth token lifetimes (Phase 8) ---
# How long an email-verification link stays valid. Longer is friendlier and
# widens the window in which a forwarded message can be redeemed. Default 48.
EMAIL_VERIFICATION_TTL_HOURS=48
# Password-reset link lifetime. Short on purpose: the link is a full account
# takeover for as long as it lives. Default 60.
PASSWORD_RESET_TTL_MINUTES=60
# Invitation lifetime. Past it the invitation is swept to `expired` on the next
# list read (lazily and idempotently — this platform runs no cron). Default 14.
INVITATION_TTL_DAYS=14
# How long a half-finished MFA challenge stays answerable. Default 10.
MFA_CHALLENGE_TTL_MINUTES=10
# Absolute ceiling on a device session regardless of refresh activity: after
# this the device must sign in again even if it never went idle. Default 30.
SESSION_ABSOLUTE_TTL_DAYS=30

# --- Lockout thresholds (Phase 8) ---
# Consecutive failures inside LOGIN_FAILURE_WINDOW_MINUTES before the account
# is locked for LOGIN_LOCKOUT_MINUTES. Raising the count makes online password
# guessing cheaper; lowering it makes a forgetful user easier to lock out, and
# also makes it easier for an attacker to lock a known account out on purpose.
# Defaults 5 / 15 / 15. Distinct from AUTH_RATE_LIMIT_MAX_PER_MINUTE, which is
# per-IP and does nothing against a distributed attempt on one account.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
# The same, for a second-factor challenge. Defaults 5 / 15.
MFA_MAX_FAILED_ATTEMPTS=5
MFA_LOCKOUT_MINUTES=15
# How many single-use recovery codes an enrolment issues. Default 10.
MFA_RECOVERY_CODE_COUNT=10

# --- Credential handling (Phase 8) ---
# bcrypt work factor. 10 is the platform default and what every existing hash
# was made with; each hash carries its own cost, so raising this does not
# invalidate anything — new and rehashed passwords simply cost more. Above ~12
# a login costs hundreds of milliseconds of CPU, which is a denial-of-service
# surface on the login route as much as a defence.
BCRYPT_COST=10
# Key for the only two secrets on the platform that CANNOT be hashed, because
# they must be replayed: an identity provider's OAuth client secret (sent to
# the IdP token endpoint) and a TOTP seed (used to recompute the expected
# digits). Generate: openssl rand -hex 32
# UNSET, the key is derived from AUTH_SECRET instead — which still defeats a
# stolen database dump, but NOT an attacker who already holds the JWT secret,
# since one value then unlocks both. Rotating this makes existing ciphertext
# unreadable: re-encrypt before you change it, or every SSO connection and
# every MFA enrolment stops working at once.
# SSO_ENCRYPTION_KEY=

# =============================================================================
# PLATFORM UPGRADE WAVE — variables the API reads that were never documented
#
# Everything below is read by apps/api/src/config.ts today. An operator who
# cannot see a switch cannot set it, and several of these decide whether a
# production deployment is safe, so they are listed with the consequence of
# leaving each one alone.
# =============================================================================

# --- Boot guards: refuse a deployment that is quietly smaller than it looks ---
# Production REFUSES to boot on the embedded in-container database unless this
# is set. PGlite is wiped on every redeploy and cannot be shared between
# replicas; a platform whose product is the durability of its record must not
# report healthy on it. Set it ONLY for a deliberate throwaway environment.
# ALLOW_EMBEDDED_DB=false
# The same guard for the local-disk storage driver in production. It needs a
# mounted volume and exactly one replica (on Railway also RAILWAY_RUN_UID=0).
# STORAGE_DRIVER=s3 is the recommended production driver and needs no volume.
# ALLOW_LOCAL_STORAGE=false

# --- Browser origins ---
# Comma-separated origins allowed to call the API cross-origin WITH
# credentials. The SPA is served same-origin in production, so this is normally
# empty; APP_BASE_URL's origin is always allowed. Reflecting every origin with
# credentials — which is what an unset allowlist used to do — is the textbook
# misconfiguration: any site could then make credentialed calls.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# --- Proxy trust ---
# TRUST_PROXY makes the API believe x-forwarded-* — required behind Railway, an
# ALB or a CDN, and WRONG anywhere else (a client could then forge its own
# address and dodge the per-IP limits and the tenant IP allowlist).
# TRUST_PROXY=true
# How many proxy hops to trust. 1 (the default) trusts only the platform edge,
# so a client cannot prepend a fake X-Forwarded-For. Raise it only when there
# is genuinely another trusted proxy in front of the edge; each increment is
# one more hop whose word is taken for the client's address.
TRUST_PROXY_HOPS=1

# --- Uploads ---
# Per-file multipart ceiling, in bytes. Uploads are buffered per request, so
# this bounds memory per in-flight upload. Default 268435456 (256 MiB).
# UPLOAD_MAX_BYTES=268435456
# UPLOAD_MAX_FILES=25

# --- The platform job scheduler (apps/api/src/lib/scheduler.ts) ---
# Every time-driven behaviour — session and invitation expiry, security-webhook
# delivery, deadline sweeps, heartbeat seals — runs on this ticker. Turning it
# off does not make those things happen later; it makes them not happen.
# Disabled automatically under NODE_ENV=test.
SCHEDULER_ENABLED=true
# Tick granularity in ms. A job's `everyMs` is rounded up to this. Default 60000.
SCHEDULER_TICK_MS=60000

# --- Database pool ---
# Maximum Postgres connections this process opens. Multiply by your replica
# count and compare with the server's max_connections before raising it.
DATABASE_POOL_MAX=10

# --- Security webhooks (WP-AUTH) ---
# A tenant's security events (sign-ins, failures, lockouts, policy changes,
# SCIM provisioning) are pushed to endpoints registered at
# POST /api/v1/company/security-webhooks and signed with a secret derived from
# WEBHOOK_SIGNING_KEY (above). No extra variable is needed to enable them.
# Destinations are checked against the SSRF policy on EVERY delivery, not only
# at registration, because DNS moves. This names hosts that may be targeted
# anyway — use it only for a test receiver inside your own network.
# WEBHOOK_ALLOW_HOSTS=siem.internal.example.com

# --- Tenant security policy (spec #23, #24, #25) ---
# There are no environment variables for the session timeout, password policy,
# lockout thresholds or IP allowlist: they are PER TENANT, set by an owner or
# admin at PUT /api/v1/company/security-policy and visible in the web app under
# Security. The LOGIN_* and SESSION_* values above are the platform DEFAULTS a
# tenant that has chosen nothing inherits; a tenant may tighten them and never
# loosen them below the platform floor.

# --- Retention of the authentication record (spec §0.2 #46, #47) ---
# Also per tenant, not per environment: an owner sets how long the sign-in
# audit and the message log stay identifiable at PUT /company/security-policy,
# and a legal hold on the same page suspends every sweep for that tenant. The
# platform default is KEEP — a retention default that deleted records would opt
# every existing customer into destroying evidence they never agreed to lose.
# The sweep runs daily as the scheduler job `account.trail-retention`.

# --- Runtime knobs the API reads but rarely needs changing ---
# development | test | production. Production turns on the boot guards above,
# masks 5xx messages and restricts CORS to the origins listed here.
# NODE_ENV=production
# fatal | error | warn | info | debug | trace. Default info.
# LOG_LEVEL=info
# Access-token lifetime in seconds (default 900). Short on purpose: a stolen
# access token cannot be revoked, only outlived — revocation happens at the
# session and refresh-token level.
# ACCESS_TOKEN_TTL_SECONDS=900
# Refresh-token lifetime in days (default 30). A device that goes quiet for
# longer than this signs in again. SESSION_ABSOLUTE_TTL_DAYS is the harder
# ceiling and applies however active the device has been.
# REFRESH_TOKEN_TTL_DAYS=30
# Where the embedded PGlite database lives when DATABASE_URL is unset. Inside a
# container this is ephemeral — see ALLOW_EMBEDDED_DB above.
# PGLITE_DIR=.pglite
# Directory the migrations are replayed from. Set in the Docker image; leave it
# alone unless you have moved packages/db/drizzle.
# MIGRATIONS_DIR=

# --- Web ---
# Base URL the web app uses to reach the API (Vite dev server proxies /api)
VITE_API_URL=http://localhost:4000
