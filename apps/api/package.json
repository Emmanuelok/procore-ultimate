{
  "name": "@constructos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "eval:retrodetect": "tsx src/scripts/retrodetect.ts",
    "verify:receipt": "tsx src/scripts/verify-receipt.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@aws-sdk/client-s3": "^3.1115.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@constructos/db": "workspace:*",
    "@constructos/ledger": "workspace:*",
    "@constructos/shared": "workspace:*",
    "@electric-sql/pglite": "^0.5.5",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.2.9",
    "nanoid": "^6.0.1",
    "pdfjs-dist": "^6.2.108",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
